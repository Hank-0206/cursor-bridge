{
  "model": "claude-sonnet-4-5",
  "instructions": "You are Codex, a coding agent.",
  "input": [
    { "type": "message", "role": "user", "content": [{ "type": "input_text", "text": "列出当前目录文件" }] }
  ],
  "tools": [
    {
      "type": "function",
      "name": "shell",
      "description": "Run a shell command",
      "parameters": {
        "type": "object",
        "properties": { "command": { "type": "array", "items": { "type": "string" } } },
        "required": ["command"]
      }
    }
  ],
  "stream": true,
  "store": false
}
